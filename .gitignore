dump/
work/pipeline.log
work/progress.txt
work/*.dll
work/*.bmp
*.bridge
!data/offsets.genuine.bridge

# editor noise
.vs/
*.user
*.suo
obj/
__pycache__/

# release assets (built, uploaded separately)
assets-release/
